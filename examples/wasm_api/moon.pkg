import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/double",
  "connect0459/starlark/eval",
  "connect0459/starlark/value",
  "connect0459/starlark/lib/json",
}

options(
  link: {
    "wasm-gc": {
      "exports": [
        "exec_script",
        "exec_script_with_env",
        "exec_script_with_options",
      ],
      "use-js-builtin-string": true,
    },
    "js": {
      "exports": [
        "exec_script",
        "exec_script_with_env",
        "exec_script_with_options",
      ],
      "format": "esm",
    },
  },
)

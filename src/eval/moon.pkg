import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/double",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/int64",
  "moonbitlang/core/math",
  "moonbitlang/core/string",
  "connect0459/starlark/errors",
  "connect0459/starlark/syntax",
  "connect0459/starlark/value",
  "connect0459/starlark/internal/compile",
  "connect0459/starlark/internal/numeric",
  "connect0459/starlark/internal/parser",
  "connect0459/starlark/internal/resolver",
  "connect0459/starlark/internal/utf8util",
}

options(
  "native-stub": [ "eval_native.c" ],
  targets: {
    "eval_print_native.mbt": [ "native", "llvm" ],
    "eval_print_stub.mbt": [ "wasm", "wasm-gc", "js" ],
  },
)

import {
  "moonbitlang/x/time" @x_time,
  "connect0459/starlark/value",
  "connect0459/starlark/internal/utf8util",
  "connect0459/starlark/unpack",
}

options(
  "native-stub": [ "time_now_native.c" ],
  targets: {
    "time_now_native.mbt": [ "native", "llvm" ],
    "time_now_js.mbt": [ "js" ],
    "time_now_stub.mbt": [ "wasm", "wasm-gc" ],
    "tz_native.mbt": [ "native", "llvm" ],
    "tz_stub.mbt": [ "wasm", "wasm-gc", "js" ],
    "time_tz_native_wbtest.mbt": [ "native", "llvm" ],
  },
)

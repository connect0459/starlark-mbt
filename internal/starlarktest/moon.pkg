import {
  "moonbitlang/core/bench",
  "connect0459/starlark/errors",
  "connect0459/starlark/eval",
  "connect0459/starlark/value",
  "connect0459/starlark/lib/json",
  "connect0459/starlark/lib/math",
  "connect0459/starlark/lib/struct",
  "connect0459/starlark/lib/time",
  "connect0459/starlark/internal/numeric",
}

options(
  targets: { "time_tz_native_test.mbt": [ "native", "llvm" ] },
  "pre-build": [
    {
      "command": ":embed --text --name assign_star -i $input -o $output",
      "input": "vendor/starlark-go/starlark/testdata/assign.star",
      "output": "assign_star_test.mbt",
    },
    {
      "command": ":embed --text --name bool_star -i $input -o $output",
      "input": "vendor/starlark-go/starlark/testdata/bool.star",
      "output": "bool_star_test.mbt",
    },
    {
